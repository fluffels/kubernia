// Element-Arten des Architekturmodells (ADR 0020).
// Gebunden an eine SSOT (check:c4 gleicht ab): schicht, bibliothek, modul, port, adapter, dazu die Harness-Arten
// agent, skill, workflow, hook, githook, gate, ciworkflow, mcp (Quellen: architektur.bindungen in scripts/docs-gen/config.json).
// Erzählung (frei, nicht ableitbar): person, system, container, datenspeicher.
// port/adapter: hexagonale Sicht (ADR 0024), gebunden an die Tabellen in docs/arc42-architektur.md.
specification {
  tag treibend
  tag getrieben
  tag hexagon
  element person {
    style {
      shape person
    }
  }
  element system
  element container
  element datenspeicher {
    style {
      shape storage
    }
  }
  element schicht
  element bibliothek {
    style {
      shape component
    }
  }
  element modul {
    style {
      shape component
    }
  }
  element port {
    style {
      shape queue
      color amber
    }
  }
  element adapter {
    style {
      shape rectangle
      color green
    }
  }
  element agent {
    style {
      shape person
    }
  }
  element skill {
    style {
      shape component
    }
  }
  element workflow {
    style {
      shape component
    }
  }
  element hook {
    style {
      shape queue
    }
  }
  element githook {
    style {
      shape queue
    }
  }
  element gate {
    style {
      shape rectangle
    }
  }
  element ciworkflow {
    style {
      shape rectangle
    }
  }
  element mcp {
    style {
      shape component
    }
  }
}
