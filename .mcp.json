{
  "mcpServers": {
    "pixellab": {
      "type": "http",
      "url": "https://api.pixellab.ai/mcp",
      "headers": {
        "Authorization": "${PIXELLAB_TOKEN}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--isolated",
        "--caps",
        "devtools",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
