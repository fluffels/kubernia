{
  "markdown": ["README.md", "docs"],
  "gates": {
    "package": "package.json",
    "chains": ["verify", "verify:full"],
    "descriptions": {
      "typecheck": "voll `strict`, ganzes Projekt",
      "lint": "ESLint typbewusst, `--max-warnings 0`, `any` blockt, Komplexität je Funktion",
      "check:arch": "Schichtung, keine Zyklen, kein toter Code (dependency-cruiser)",
      "check:size": "God-File-Frühwarnung (Zeilen-Budget je Modul)",
      "check:contextsize": "Größenbudget jeder AGENTS.md (Zeichen)",
      "check:anysuppress": "Ratchet auf die Zahl begründeter `any`-Ausnahmen",
      "check:docmap": "jede `src/`-Datei ist in einem Tiefendoc erwähnt, die Landkarte kann nicht leise veralten",
      "check:docdrift": "dokumentierte `npm run`-Kommandos, interne Doku-Links und Anker, verify-Ketten-Kopien",
      "check:docgen": "generierte Doku-Abschnitte (`GEN:`-Marker) stimmen mit dem Repo überein",
      "check:c4": "LikeC4-Modell: validiert, formatiert; Schichten, Phaser, Schicht-Kanten und Top-Level-Module stimmen mit `scripts/layers.cjs` und `src/` überein",
      "check:internalrefs": "keine internen Bezüge im öffentlichen Repo",
      "check:steuerbytes": "keine Steuerbytes (NUL) in Textdateien",
      "check:lockfile": "Lockfile passt zur `package.json`",
      "check:diffsize": "Slice-Größe (Dateien und Zeilen gegen die Merge-Base)",
      "test": "Verhalten von Domäne, Sim, Wirtschaft und Harness-Wächtern, inkl. Negativ- und Grenzfälle (Vitest)",
      "test:coverage": "Coverage-Floors je Schicht-Bucket",
      "check:diffcoverage": "Abdeckung der im Slice geänderten Zeilen",
      "build": "Host-Build (`dist/`) baut fehlerfrei",
      "build:offline": "Offline-Einzeldatei (`dist-offline/index.html`) baut fehlerfrei",
      "check:bundle": "Byte-Budget je Chunk-Art: Offline-HTML, Spielcode, Content-Chunks (je Datei), Phaser-Chunk",
      "test:smoke": "Boot- und Interaktions-Smokes headless gegen Offline- und Host-Build (Playwright)"
    },
    "ci": [
      {
        "command": "npm audit --omit=dev --audit-level=high",
        "source": ".github/workflows/ci.yml",
        "description": "Security-Gate über die ausgelieferten Produktiv-Abhängigkeiten"
      },
      {
        "command": "node scripts/check-review-nachweis.mjs",
        "source": ".github/workflows/ci.yml",
        "description": "Review-Nachweis (`KQ-Plan:`/`KQ-Review:`) im PR"
      }
    ]
  },
  "schichten": {
    "layers": "scripts/layers.cjs",
    "pruefbefehl": "npm run check:arch",
    "cruise": [
      "node_modules/dependency-cruiser/bin/dependency-cruiser.mjs",
      "src",
      "--config",
      ".dependency-cruiser.cjs",
      "--output-type",
      "json",
      "--collapse",
      "^(src|node_modules)/[^/]+/"
    ]
  },
  "adr": {
    "ordner": "docs/adr"
  },
  "kennzahlen": {
    "package": "package.json",
    "chains": ["verify", "verify:full"],
    "skripte": ["scripts"],
    "skriptEndungen": [".mjs", ".cjs"],
    "waechter": { "ordner": "test/harness" },
    "workflows": ".github/workflows",
    "adr": "docs/adr"
  },
  "zeitleiste": {
    "meilensteine": "docs/meilensteine.json"
  },
  "diagramme": {
    "vorlagen": {
      "agenten-ablauf": "docs/diagramme/agenten-ablauf.mmd",
      "agenten-sequenz": "docs/diagramme/agenten-sequenz.mmd",
      "leitplanken-schichten": "docs/diagramme/leitplanken-schichten.mmd"
    },
    "vollstaendig": ["agenten-ablauf", "agenten-sequenz"],
    "konstanten": {
      "lensCap": { "datei": ".claude/workflows/kubernia-ticket.js", "name": "MAX_REVIEW_RUNDEN" },
      "fixVersuche": { "datei": ".claude/workflows/kubernia-ticket.js", "name": "MAX_FIX_VERSUCHE" },
      "festgefahrenCommits": { "datei": "scripts/check-festgefahren.mjs", "name": "MAX_FAILED_PUSHES" }
    },
    "ruleset": ".github/ruleset-main-schutz.json",
    "ciWorkflows": ".github/workflows"
  },
  "harness": {
    "agents": ".claude/agents",
    "skills": ".claude/skills",
    "workflows": ".claude/workflows",
    "settings": ".claude/settings.json",
    "gitHooks": ".githooks",
    "mcp": ".mcp.json"
  },
  "saveVersionen": {
    "beschreibungen": "src/store/save-versionen.json",
    "version": { "datei": "src/store/versioning.ts", "name": "CURRENT_SAVE_VERSION" }
  },
  "quests": {
    "ordner": "src/content/data/quests",
    "reihenfolge": "src/content/data/quest-order.json",
    "themen": "src/content/data/quest-topics.json",
    "standplaetze": "src/content/data/entities.json",
    "npcs": "src/content/data/npcs.json",
    "maxQuestsJeDiagramm": 30
  },
  "architektur": {
    "workspace": "docs/architektur",
    "quelle": "src",
    "bindungen": { "schicht": "schicht", "bibliothek": "extern", "modul": "modul" },
    "erzaehlung": ["person", "system", "container", "datenspeicher"],
    "maxKnotenJeView": 25
  }
}
