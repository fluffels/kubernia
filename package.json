{
  "name": "kubernia",
  "version": "3.0.0",
  "description": "Kubernia – das Hafen-Abenteuer: ein 2D-Lernspiel für Docker, Kubernetes, Helm & Terraform.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:offline": "vite build --mode offline",
    "build:devpanel": "vite build --mode devpanel",
    "preview": "vite preview",
    "preview:offline": "vite preview --outDir dist-offline",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "smoke": "npm run build:offline && playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "check:size": "node scripts/check-size.mjs",
    "check:contextsize": "node scripts/check-context-size.mjs",
    "check:docmap": "node scripts/check-docmap.mjs",
    "check:docdrift": "node scripts/check-docdrift.mjs",
    "check:internalrefs": "node scripts/check-internalrefs.mjs",
    "check:diffsize": "node scripts/check-diffsize.mjs",
    "check:anysuppress": "node scripts/check-any-suppressions.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:doctickets": "node scripts/check-doc-tickets.mjs",
    "check:tseslint-ts7": "node scripts/check-tseslint-ts7.mjs",
    "check:duplication": "jscpd src",
    "lint": "eslint . --max-warnings 0",
    "lint:prune": "eslint . --prune-suppressions",
    "lint:suppress": "eslint . --suppress-rule complexity --suppress-rule max-depth --suppress-rule max-lines-per-function --suppress-rule @typescript-eslint/no-unsafe-member-access --suppress-rule @typescript-eslint/no-unsafe-call --suppress-rule @typescript-eslint/no-unnecessary-type-assertion --suppress-rule @typescript-eslint/no-unsafe-assignment --suppress-rule @typescript-eslint/no-unsafe-return --suppress-rule @typescript-eslint/no-unsafe-argument --suppress-rule @typescript-eslint/prefer-promise-reject-errors --suppress-rule @typescript-eslint/restrict-template-expressions --suppress-rule @typescript-eslint/no-base-to-string --suppress-rule @typescript-eslint/no-redundant-type-constituents --suppress-rule @typescript-eslint/unbound-method --suppress-rule @typescript-eslint/no-misused-promises",
    "quiz:golden": "node scripts/quiz-golden.mjs",
    "pack:sprites": "node scripts/pack-sprites.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:arch && npm run check:size && npm run check:contextsize && npm run check:anysuppress && npm run check:docmap && npm run check:docdrift && npm run check:internalrefs && npm run check:lockfile && npm run check:diffsize && npm test",
    "verify:full": "npm run verify && npm run test:coverage && npm run build && npm run build:offline && npm run check:bundle && npm run test:smoke"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.7.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "jscpd": "^5.0.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^4.1.9"
  }
}
