name: CI

# Qualitätstore bei jedem Push auf main und bei jedem Pull Request.
on:
  push:
    branches: [main]
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
  workflow_dispatch:

# Veraltete Runs desselben Branches oder PRs abbrechen, sobald ein neuer startet.
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  build-test:
    name: Tests, Typecheck & Builds
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
      issues: read
    steps:
      - name: Checkout
        uses: actions/checkout@v7
        with:
          # Volle Historie, damit check:diffsize den PR-Slice gegen die PR-Basis messen kann.
          fetch-depth: 0

      - name: Node einrichten
        uses: actions/setup-node@v7
        with:
          node-version-file: .nvmrc
          cache: npm

      - name: Abhängigkeiten installieren
        run: npm ci

      # Auf einem PR ist die Diff-Basis der erste Elternteil des Merge-Commits, auf main der Vorgänger-Commit.
      - name: Diff-Basis bestimmen
        env:
          EVENT_NAME: ${{ github.event_name }}
          BEFORE_SHA: ${{ github.event.before }}
        run: |
          if [ "$EVENT_NAME" = "pull_request" ]; then
            base=$(git rev-parse HEAD^1)
          else
            base="$BEFORE_SHA"
          fi
          echo "FACTORY_DIFF_BASE=$base" >> "$GITHUB_ENV"

      # Alle Gates laufen über EINE Kette statt einzeln dupliziert: sie steht in package.json › scripts.verify, nicht hier
      # kopiert, damit die lokale Reihenfolge nicht von der CI driftet und kein Gate lokal vergessen wird. Coverage und
      # Diff-Coverage sind eigene Schritte dahinter (zusammen = `npm run verify:full`), weil die Instrumentierung die Suite verlangsamt.
      - name: Verify, alle Gates in einer Kette
        run: npm run verify

      - name: Coverage-Gate
        run: npm run test:coverage

      # Misst nur die im Slice geänderten Zeilen (coverage/lcov.info aus dem Lauf davor, geschnitten mit dem Diff), darum NACH
      # test:coverage; FACTORY_DIFF_BASE kommt aus „Diff-Basis bestimmen“ oben.
      - name: Diff-Coverage-Gate
        run: npm run check:diffcoverage

      - name: Review- und Plan-Nachweis prüfen
        if: ${{ !cancelled() && github.event_name == 'pull_request' && github.event.pull_request.user.login != 'dependabot[bot]' }}
        run: node scripts/check-review-nachweis.mjs

      # Abnahme-Nachweis: Urteil je Akzeptanzkriterium des verknüpften Tickets plus Spur als PR-Kommentar (Format: docs/agent-harness.md §3a).
      # Letzter Schritt, im Required-Job (kein neuer Required-Check). Ein Entwurf wird nur berichtet, maßgeblich ist der Lauf nach
      # `ready_for_review`. Werte aus dem Ereignis nur über `env:`, nie per Ausdruck im `run:` (Script-Injection). GH_TOKEN liest Issue und
      # Kommentare (Rechte `pull-requests` und `issues` read oben).
      - name: Abnahme-Nachweis prüfen
        if: ${{ !cancelled() && github.event_name == 'pull_request' && github.event.pull_request.user.login != 'dependabot[bot]' }}
        env:
          GH_TOKEN: ${{ github.token }}
          FACTORY_PR_NUMBER: ${{ github.event.pull_request.number }}
          FACTORY_PR_DRAFT: ${{ github.event.pull_request.draft }}
          FACTORY_PR_BODY: ${{ github.event.pull_request.body }}
        run: node scripts/check-abnahme-nachweis.mjs

  security-audit:
    name: Security-Audit (npm audit)
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Node einrichten
        uses: actions/setup-node@v7
        with:
          node-version-file: .nvmrc
          cache: npm

      - name: Audit der Abhängigkeiten (blockt bei high und höher)
        run: npm audit --audit-level=high

  # Doku-Aktualitäts-Wächter: gleicht die in der Doku als „offen“ markierten Roadmap-Tickets gegen den echten gh-issue-Status ab und
  # ALARMIERT, wenn ein längst geschlossenes Ticket noch als offen dokumentiert ist. Bewusst nicht in der hermetischen `verify`-Kette:
  # der Abgleich braucht Netz und Token. continue-on-error: nicht blockierend, der rote Schritt bleibt als Alarm sichtbar. Kein `npm ci`
  # nötig (nur Node-Builtins und gh).
  doc-freshness:
    name: Doku-Aktualität (Roadmap-Tickets)
    runs-on: ubuntu-latest
    permissions:
      contents: read
      issues: read # check-doc-tickets.mjs liest den Issue-Status per gh
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Node einrichten
        uses: actions/setup-node@v7
        with:
          node-version-file: .nvmrc

      - name: Offen-markierte Roadmap-Tickets gegen gh-Status prüfen
        continue-on-error: true
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: node scripts/check-doc-tickets.mjs

  # Post-hoc-Netz auf main: ein roter `main` trotz grüner PR-Checks (semantischer Merge zweier je grüner PRs, ein fehlkonfigurierter Required
  # Check, ein Admin- oder Force-Push) öffnet ein Alarm-Issue, NUR auf push und ohne den Workflow zu blockieren. Ein roter PR ist Sache der
  # Autorin. Priorisiert über die Board-Position: Issue mit einem existierenden Label anlegen und per `board-place.mjs --notfall rot-main --top`
  # an die OBERSTE Board-Position setzen (ein roter `main` blockiert jeden parallelen Agenten). Dedup läuft über den Titel-Präfix, nicht über ein
  # Label. Board-Schreibzugriff braucht das Secret PROJECT_TOKEN (das Standard-GITHUB_TOKEN kann kein User-Project V2 schreiben); fehlt es,
  # entsteht das Issue trotzdem und steht nur nicht garantiert oben.
  alarm-red-main:
    name: Alarm bei rotem main
    needs: [build-test, security-audit]
    if: failure() && github.event_name == 'push'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      issues: write
    steps:
      # Volles Repo und Node für scripts/board-place.mjs (Board-Position mit Wiederholung); kein npm ci nötig.
      # continue-on-error: scheitert der Checkout, entsteht das Issue trotzdem, die Positionierung scheitert dann sichtbar rot.
      - name: Repo auschecken
        continue-on-error: true
        uses: actions/checkout@v7

      - name: Node einrichten
        continue-on-error: true
        uses: actions/setup-node@v7
        with:
          node-version-file: .nvmrc

      - name: Alarm-Issue öffnen oder ergänzen
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          SHA: ${{ github.sha }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          COMMIT_URL: ${{ github.server_url }}/${{ github.repository }}/commit/${{ github.sha }}
          # Das Standard-GITHUB_TOKEN kann NICHT in ein User-Project V2 schreiben, dafür ein PAT mit project-Scope als Secret PROJECT_TOKEN.
          # Fehlt es, wird nur gewarnt.
          PROJECT_TOKEN: ${{ secrets.PROJECT_TOKEN }}
          # Existierendes Label des Projekts.
          ALARM_LABEL: area:harness
        run: |
          set -euo pipefail
          marker="🚨 CI rot auf main"
          short="${SHA:0:7}"

          # Gibt es schon ein OFFENES Alarm-Issue? Titel-Präfix-Match über die offenen Issues mit dem Alarm-Label. Solange main rot bleibt,
          # hängen weitere rote Läufe nur einen Kommentar an, statt zu spammen.
          existing=$(gh issue list --repo "$REPO" --state open --label "$ALARM_LABEL" --limit 1000 \
            --json number,title \
            --jq "[.[] | select(.title | startswith(\"$marker\"))][0].number // empty")

          if [ -n "$existing" ]; then
            echo "Bestehendes Alarm-Issue #$existing – ergänze Kommentar."
            gh issue comment "$existing" --repo "$REPO" \
              --body "🔴 Erneut rot auf \`main\` bei Commit [\`${short}\`](${COMMIT_URL}) → [CI-Lauf](${RUN_URL})."
          else
            echo "Lege neues Alarm-Issue an."
            body=$(printf '%s\n' \
              "Der CI-Lauf auf \`main\` ist **rot**, obwohl \`main\` PR-gegated ist: ein semantischer Merge zweier je grüner PRs, ein fehlkonfigurierter Required Check oder ein Admin- oder Force-Push." \
              "" \
              "- Commit: [\`${short}\`](${COMMIT_URL})" \
              "- Fehlgeschlagener Lauf: ${RUN_URL}" \
              "" \
              "**Zuerst behandeln** (main muss grün sein, bevor ein paralleler Agent darauf aufbaut): Ursache im Lauf ansehen, auf einem Fix-Branch reparieren, per PR mergen, dieses Issue schließen. Solange main rot bleibt, hängt jeder weitere rote Lauf nur einen Kommentar hier an (kein Issue-Spam).")
            new_url=$(gh issue create --repo "$REPO" \
              --title "${marker} (${short})" \
              --label "$ALARM_LABEL" \
              --body "$body")
            echo "Angelegt: ${new_url}"
            # An die oberste Board-Position schieben, nur beim NEUEN Issue, nicht beim Ergänzen eines bestehenden.
            # board-place.mjs wiederholt den Wettlauf (frisches Issue ohne GraphQL-Node) mit Pause; scheitert es endgültig, wird der Lauf rot.
            nr="${new_url##*/}"
            if [ -z "${PROJECT_TOKEN:-}" ]; then
              echo "::warning::PROJECT_TOKEN-Secret fehlt – Board-Position für #${nr} nicht gesetzt (Alarm-Issue steht dann irgendwo statt oben). PAT mit project-Scope als Secret PROJECT_TOKEN hinterlegen."
            elif ! GH_TOKEN="$PROJECT_TOKEN" node scripts/board-place.mjs --notfall rot-main --top "$nr"; then
              echo "::error::Board-Position für #${nr} nicht gesetzt – board-place.mjs ist endgültig gescheitert (Token-Scope: Issues-Zugriff auf ${REPO} UND Projects-Schreibrecht)."
              exit 1
            fi
          fi
