node_modules/
dist/
dist-offline/
dist-devpanel/
# Coverage-Berichte (#495): v8-Instrumentierung schreibt nach coverage/, nie ins Repo.
coverage/
# Playwright-Boot-Smoke-Test (#391): Browser-Artefakte/Reports, nie ins Repo.
test-results/
playwright-report/
blob-report/
playwright/.cache/
# jscpd-Duplikations-Report (#612): weiches, nicht-blockierendes CI-Artefakt, nie ins Repo.
jscpd-report/
# Lokale Umgebungsvariablen (#325): der Dev-Panel-Passwort-WERT darf nie ins Repo.
# Die Vorlage `.env.example` (nur Variablen-Namen) bleibt versioniert.
.env
.env.*.local
!.env.example
.claude/*
!.claude/skills/
# Planungs-Agenten-Datei (#745): kubernia-planner.md trägt model: claude-opus-5 und
# propagiert in jeden Worktree — dieselbe Ausnahme wie .claude/skills/.
!.claude/agents/
# Worktree-Guard-Hook (#735): settings.json trägt den PreToolUse-Hook, der
# git commit/push außerhalb eines Worktrees blockt — muss geteilt/getrackt sein,
# sonst driftet er über parallele Worktrees (dieselbe Ausnahme wie .claude/skills/).
!.claude/settings.json
# Workflow-Orchestrierung (Claude Code): kubernia-ticket.js fährt den Ticket-Ablauf
# als Phasen-Workflow und muss wie die Skills mitgetrackt werden, damit jeder Clone
# und jeder Worktree denselben Stand hat (dieselbe Ausnahme wie .claude/skills/).
!.claude/workflows/
.vscode/
.idea/*
!.idea/runConfigurations/
*.iml
Thumbs.db
.DS_Store
